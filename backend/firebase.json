{
  "firestore": {
    "database": "(default)",
    "location": "asia-south2",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "runtime": "nodejs22",
      "codebase": "default",
      "cleanupPolicy": {
        "enabled": true,
        "maxAgeDays": 30
      }
    }
  ],
  "storage": {
    "rules": "storage.rules"
  }
}